{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reminder-agent",
  "main": "src/index.ts",
  "upload_source_maps": true,
  // Set to the date you start the project; bump it deliberately, not by habit.
  "compatibility_date": "2026-10-23",
  // Required by the agents package.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ReminderAgent", "class_name": "ReminderAgent" }]
  },
  // Storage for each Agent class: SQLite. (Older projects use "migrations" with "new_sqlite_classes"; both work.)
  "exports": {
    "ReminderAgent": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true }
}
